APP_NAME=YulduzBox
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://stars_user:CHANGE_ME@localhost:5432/stars_db

# BotFather bergan token
BOT_TOKEN=CHANGE_ME
# Mini App manzili (Telegram uchun HTTPS bo'lishi shart)
WEBAPP_URL=https://example.trycloudflare.com
# Admin Telegram ID lari, vergul bilan: 123456789,987654321
SUPPORT_USERNAME=AnvarovCoder
ADMIN_TELEGRAM_IDS=

# initData necha soniyadan keyin eskirgan hisoblanadi (86400 = 24 soat)
INITDATA_MAX_AGE_SECONDS=86400
CORS_ORIGINS=http://localhost:5173

# FAQAT ENVIRONMENT=development da ishlaydi. Oddiy brauzerda sinash uchun soxta foydalanuvchi ID si.
# Productionda bu qatorni O'CHIRIB QO'YING.
DEV_FAKE_USER_ID=
